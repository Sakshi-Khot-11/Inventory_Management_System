@page "/edit-product/{ID:int}"
@using Inventory_Management_System.Services
@inject ProductServices productServices
@using Inventory_Management_System.Models
@inject NavigationManager navManager
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json


<h3>EditProduct</h3>
@if (editProduct == null)
{
    <p>product not found</p>
}
else
{
    <EditForm Model="@editProduct" FormName="EditProductform" OnSubmit="UpdateProduct">
        <div>
            <label>Product Id</label>
            <InputNumber @bind-Value="editProduct.ID"></InputNumber>
        </div>

        <div>
            <label>Product Name</label>
            <InputText @bind-Value="editProduct.Name"></InputText>
        </div>

        <div>
            <label>Stock</label>
            <InputNumber @bind-Value="editProduct.Stock"></InputNumber>
        </div>

        <div>
            <label>Price</label>
            <InputNumber @bind-Value="editProduct.Price"></InputNumber>
        </div>

        <button type="submit"> Save changes</button>
    </EditForm>
}

@code {
    [Parameter]
    public int ID { get; set; }
    Product editProduct;
    string msg = "";
    protected override void OnParametersSet()
    {
        editProduct = productServices.products.FirstOrDefault(p => p.ID == ID);
    }
  
    private async Task UpdateProduct()
    {
        var client = HttpClientFactory.CreateClient("InventoryApi");
        var response = await client.PutAsJsonAsync($"api/product/{ID}", editProduct);
        if (response.IsSuccessStatusCode)
        {
            navManager.NavigateTo("/products");
        }
        else
        {
            msg = await response.Content.ReadAsStringAsync();
        }

    }


    // void UpdateProduct()
    // {
    //     navManager.NavigateTo("/products");
    // }
}
