@page "/add-product"
@using Inventory_Management_System.Models
@using Inventory_Management_System.Components.Pages
@using Inventory_Management_System.Services
@inject ProductServices productServices
@inject NavigationManager navManager
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json




<h3>AddProduct</h3>

<EditForm Model=@newProduct FormName="AddProductFrom" OnSubmit="@AddNewProduct">
    <div>
        <label>Product ID</label>
        <InputNumber @bind-Value="newProduct.ID"/>
    </div>
    <div>
        <label>Product Name</label>
        <InputText @bind-Value="newProduct.Name"></InputText>
    </div>
    <div>
        <label>Product stock</label>
        <InputNumber @bind-Value="newProduct.Stock"></InputNumber>
    </div>

    <div>
        <label>Product Price</label>
        <InputNumber @bind-Value='newProduct.Price'></InputNumber>
    </div>
    <button >Add Product</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
        Cancel
    </button>

</EditForm>
@if (!string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-danger mt-3">
        @msg
    </div>
}

@code {
    Product newProduct = new Product();
    string msg = "";

    private async Task AddNewProduct()
    {
        var client = HttpClientFactory.CreateClient("InventoryApi");
        var response = await client.PostAsJsonAsync(
            "api/product", newProduct);
        if (response.IsSuccessStatusCode)
        {
            navManager.NavigateTo("/products");
        }
        else
        {
            msg = await response.Content.ReadAsStringAsync();
        }

    }




    // public void AddNewProduct()
    // {
    //     productServices.products.Add(newProduct);
    //     newProduct = new Product();
    //     navManager.NavigateTo("/products");
    // }
    public void Cancel()
    {
        navManager.NavigateTo("/products");
    }


}
